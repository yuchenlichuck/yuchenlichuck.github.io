&lt;/div&gt; --&gt;
&lt;div class="row justify-content-center" style="padding: 0; margin: 0;"&gt;
&lt;div class="col-sm-12 text-center quantitative-results-media"&gt;
&lt;img src="assets/images/results.jpeg" alt="Image description" class="img-fluid"&gt;
&lt;/div&gt;
&lt;/div&gt;
